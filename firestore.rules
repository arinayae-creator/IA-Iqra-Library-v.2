rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate non-empty string IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isValidId(bookId);
    }

    match /book_customizations/{bookId} {
      allow read: if true;
      allow write: if isValidId(bookId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    match /scan_history/{historyId} {
      allow read: if true;
      allow write: if isValidId(historyId);
    }

    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
